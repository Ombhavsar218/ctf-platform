# Copy to .env and adjust for your machine.
#
# Must be the backend origin + /api/v1/ + trailing slash. Only VITE_* variables
# reach the bundle, so never put secrets in this file.
#
# The origin (e.g. http://localhost:5173) must also be listed in the backend's
# CORS_ALLOWED_ORIGINS. If the backend runs on another port (8000 is the
# default), update both values.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1/

# Production same-origin build: the reverse proxy serves both the SPA and the
# API, so CORS is not needed. This value is baked into the bundle; rebuild after
# changing it. See ../ctf-platform-be/DEPLOYMENT.md.
# VITE_API_BASE_URL=/api/v1/
